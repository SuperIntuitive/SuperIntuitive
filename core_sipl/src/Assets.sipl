use Config
use Tools
use Page
use Security
use Sessions
use Deployment
use Editor
use SetupAuthorization

var _domainAtStartup = ""
fn mediaRoot(domain: String) { _domainAtStartup = domain }

fn initialMedia(pathname: String) {
    // web.serve fixes its static root when it starts. A fresh installer starts
    // before its domain folder exists. Serve that install's bundled starter
    // assets directly until restart; arbitrary uploads still use the native
    // server's confined static reads on subsequent starts.
    if not _domainAtStartup.isEmpty or not SetupAuthorization.locked() { return none }
    let archive = zip.open(Config.root("core_sipl/generated/installer-media.zip"))
    let entry = pathname.slice(1)
    if not zip.list(archive).contains(entry) { zip.close(archive)
        return none }
    let body = zip.read(archive, entry)
    zip.close(archive)
    var kind = contentType(entry)
    if entry.endsWith(".wav") { kind = "audio/wav" }
    return {"body": body, "headers": {"Content-Type": kind}}
}

fn contentType(filename: String) -> String {
    let extension = path.extension(filename).toLower()
    let types = {".js": "application/javascript; charset=utf-8", ".css": "text/css; charset=utf-8", ".json": "application/json; charset=utf-8", ".html": "text/html; charset=utf-8", ".png": "image/png", ".gif": "image/gif", ".jpg": "image/jpeg", ".jpeg": "image/jpeg", ".svg": "image/svg+xml", ".ico": "image/x-icon", ".woff": "font/woff", ".woff2": "font/woff2", ".ttf": "font/ttf"}
    return types.get(extension, "application/octet-stream")
}

fn safePath(value: String) -> Bool {
    if value.contains("\\") or value.contains("\0") or value.contains(":") { return false }
    for part in value.split("/") {
        if part == ".." or part.startsWith(".") { return false }
        let stem = part.split(".")[0].toUpper()
        if ["CON", "PRN", "AUX", "NUL", "COM1", "COM2", "COM3", "COM4", "COM5", "COM6", "COM7", "COM8", "COM9", "LPT1", "LPT2", "LPT3", "LPT4", "LPT5", "LPT6", "LPT7", "LPT8", "LPT9"].contains(stem) { return false }
    }
    return true
}

fn staticAsset(pathname: String) -> Bool {
    if not safePath(pathname) { return false }
    if pathname.startsWith("/core_sipl/public/") {
        return ["/core_sipl/public/backend-switch.js", "/core_sipl/public/switch.css"].contains(pathname)
    }
    if pathname.startsWith("/plugins/installed/") { return [".js", ".css", ".png", ".gif", ".jpg", ".jpeg", ".webp", ".svg", ".ico", ".woff", ".woff2", ".ttf"].contains(path.extension(pathname).toLower()) }
    if pathname.startsWith("/editor/media/") { return [".json", ".png", ".gif", ".jpg", ".jpeg", ".svg", ".ico", ".woff", ".woff2", ".ttf"].contains(path.extension(pathname).toLower()) }
    if pathname.startsWith("/editor/objects/") or pathname.startsWith("/scripts/widgets/") { return pathname.endsWith(".js") }
    if pathname.startsWith("/style/") { return pathname.endsWith(".css") }
    if ["/scripts/tools.js", "/scripts/setup.js", "/editor/editor.css"].contains(pathname) { return true }
    return false
}

fn readStatic(pathname: String) -> Map {
    var filename = Config.root(pathname.slice(1))
    if pathname == "/style/widgets.css" { filename = Config.root("core_sipl/generated/widgets.css") }
    if not fs.isFile(filename) { fail("ASSET_NOT_FOUND") }
    let kind = contentType(filename)
    if kind.startsWith("text/") or kind.startsWith("application/javascript") or kind.startsWith("application/json") {
        var source = fs.readText(filename)
        // This shared JS helper contains a PHP opening tag as comment text,
        // not executable PHP. Preserve its JS value without emitting a tag.
        if pathname == "/scripts/tools.js" {
            source = source.replace("document.createComment(\"<?php ", "document.createComment(\"\\x3c?php ")
        }
        if source.contains("<?php") or source.contains("<?=") { fail("DYNAMIC_ASSET_NOT_PORTED") }
        return {"body": source, "headers": {"Content-Type": kind}}
    }
    return {"body": fs.readBytes(filename, 1048576), "headers": {"Content-Type": kind}}
}

fn bundle(context: Map, request: Map, kind: String) -> String {
    let pathname = web.sessionGet(request, Sessions.key("pagePath"), "/")
    let page = Page.load(context, pathname)
    var result = ""
    for block in page["blocks"] {
        let source = block.get(kind, "")
        if source.type == "String" {
            if kind == "style" { result += "/*-!" + block["name"].replace("*/", "") + "!-*/\n" + Deployment.mediaPaths(source, context["deployment"]) + "\n" }
            else { result += "\n/*__BLOCK=" + block["name"].replace("*/", "") + " */\n" + source + "\n/*__ENDBLOCK */\n" }
        }
    }
    if kind == "script" { result += fs.readText(Config.root("core_sipl/generated/login-binding.js")) }
    return result
}

fn editor(context: Map, request: Map) -> String {
    Security.requireAdmin(context)
    if context["deployment"] != "dev" { fail("FORBIDDEN") }
    let pathname = web.sessionGet(request, Sessions.key("pagePath"), "/")
    return Editor.render(context, Page.load(context, pathname))
}

fn safeMedia(pathname: String) -> Bool {
    if not pathname.startsWith("/media/") or not safePath(pathname) { return false }
    // These inert media formats may use the native server's confined file reads.
    return [".png", ".gif", ".jpg", ".jpeg", ".webp", ".ico", ".woff", ".woff2", ".ttf", ".mp3", ".wav", ".ogg", ".flac", ".mp4", ".webm"].contains(path.extension(pathname).toLower())
}
