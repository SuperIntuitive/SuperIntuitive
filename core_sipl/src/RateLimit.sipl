use Tools
var _buckets: Map = {:}

fn allow(name: String, limit: Int, window: Int) -> Bool {
    return allowAt(name, limit, window, Tools.now())
}

fn allowAt(name: String, limit: Int, window: Int, current: Int) -> Bool {
    let keys = _buckets.keys()
    for key in keys {
        if current - _buckets[key]["start"] >= _buckets[key]["window"] { _buckets.remove(key) }
    }
    if not _buckets.contains(name) {
        if _buckets.length >= 1024 { return false }
        _buckets[name] = {"start": current, "count": 0, "window": window}
    }
    let bucket = _buckets[name]
    bucket["count"] += 1
    return bucket["count"] <= limit
}

fn login(email: String) -> Bool {
    return allow("global-login", 60, 300) and allow("login:" + email.toLower(), 10, 300)
}
