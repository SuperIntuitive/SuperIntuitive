use ../src/Tools
use ../src/Runtime
var _checks = 0
fn check(value: Bool, message: String) { assert(value, message)
    _checks += 1 }
fn rejects(operation: Function, message: String) {
    var rejected = false
    try { operation() } fail { rejected = true }
    check(rejected, message)
}
fn start() {
    let vectors = json.parse(fs.readText(system.args[0]))
    let output = []
    for vector in vectors {
        let password = vector["password"]
        check(auth.passwordVerify(password, vector["hash"]), "Verify PHP-generated bcrypt")
        check(not auth.passwordVerify("wrong", vector["hash"]), "Reject wrong password")
        let generated = auth.bcryptHash(password, 10)
        check(generated.startsWith("$2b$10$") and generated.length == 60, "Native bcrypt format and cost")
        check(auth.passwordVerify(password, generated), "Verify native bcrypt")
        let other = auth.bcryptHash(password, 10)
        check(generated != other, "Bcrypt salts are random")
        output.push({"password": password, "hash": generated})
    }
    check(auth.bcryptHash("ten-chars!", 12).startsWith("$2b$12$"), "Production bcrypt cost")
    check(not auth.passwordVerify("password", "$2y$10$not-a-valid-hash"), "Malformed bcrypt returns false")
    check(not auth.passwordVerify("x", "$2b$99$aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"), "Unbounded cost rejected")
    rejects(fn() { auth.bcryptHash("a".repeat(73)) }, "More than 72 bytes rejected")
    rejects(fn() { auth.bcryptHash("é".repeat(37)) }, "UTF-8 password limit")
    rejects(fn() { auth.bcryptHash("nul\0value") }, "NUL password rejected")
    rejects(fn() { auth.bcryptHash("valid-password", 3) }, "Invalid cost rejected")
    check(Runtime.inspect()["phpBcryptHash"] and Runtime.inspect()["phpBcryptVerify"], "Runtime capability checks use valid PHP vectors")
    fs.writeText(system.args[1], json.stringify(output))
    print("SIPL bcrypt compatibility checks passed: {_checks}")
}
